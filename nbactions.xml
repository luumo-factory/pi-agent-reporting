<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>-Dspring.devtools.restart.enabled=true</spring-boot.run.jvmArguments>
            <spring-boot.run.mainClass>ai.luumo.tools.picodingagent.reporting.PiAgentReportingApplication</spring-boot.run.mainClass>
        </properties>
    </action>
    
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>-Xdebug -Xrunjdwp:transport=dt_socket,server=n,address=${jpda.address} -Dspring.devtools.restart.enabled=true</spring-boot.run.jvmArguments>
            <spring-boot.run.mainClass>ai.luumo.tools.picodingagent.reporting.PiAgentReportingApplication</spring-boot.run.mainClass>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
    
    <action>
        <actionName>profile</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>-Dspring.devtools.restart.enabled=false</spring-boot.run.jvmArguments>
            <spring-boot.run.mainClass>ai.luumo.tools.picodingagent.reporting.PiAgentReportingApplication</spring-boot.run.mainClass>
        </properties>
    </action>
    
    <action>
        <actionName>test</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>test</goal>
        </goals>
    </action>
    
    <action>
        <actionName>build</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>package</goal>
        </goals>
    </action>
    
    <action>
        <actionName>rebuild</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>package</goal>
        </goals>
    </action>
    
    <action>
        <actionName>test.single</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>test-compile</goal>
            <goal>surefire:test</goal>
        </goals>
        <properties>
            <test>${packageClassName}</test>
        </properties>
    </action>
    
    <action>
        <actionName>debug.test.single</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>test-compile</goal>
            <goal>surefire:test</goal>
        </goals>
        <properties>
            <test>${packageClassName}</test>
            <maven.surefire.debug>-Xdebug -Xrunjdwp:transport=dt_socket,server=n,address=${jpda.address}</maven.surefire.debug>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
</actions>
